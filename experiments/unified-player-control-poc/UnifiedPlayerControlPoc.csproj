<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>UnifiedPlayerControlPoc</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The workbench talks to independent connector processes.  Keep the old
      in-process adapters and vendor probes on disk for historical reference,
      but compile only the protocol shell and its process adapter.
    -->
    <Compile Include="Program.cs" />
    <Compile Include="MainForm.cs" />
    <Compile Include="PlayerContracts.cs" />
    <Compile Include="ConnectorProcessAdapter.cs" />
  </ItemGroup>
</Project>
